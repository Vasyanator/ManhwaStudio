<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest of the ManhwaStudio Android app.

  LaunchActivity is the launcher entry: it installs the bundled runtime files into
  filesDir/ms_root (AssetInstaller) off the UI thread, then starts MainActivity, the
  GameActivity that hosts the Rust library (android.app.lib_name = the cdylib name).

  configChanges: the Rust app lives as long as its Activity, so every configuration change a
  desktop-class session produces (DeX / freeform resize, rotation, density, keyboard or mouse
  attach, dark mode, locale) is delivered to the running Activity instead of recreating it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- eframe renders through GLES 3 (egui-shader-layers needs 3.0). -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- Downloads (chapters, fonts, spellcheck dictionaries) and AI API calls. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Secondary windows (winit's SecondaryWindowActivity tasks): programmatic focus and
         bring-to-front via ActivityManager.moveTaskToFront. -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />

    <!-- allowBackup off: the runtime root holds hundreds of MB of bundled fonts and the user's
         projects; cloud auto-backup of them is neither wanted nor bounded. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:theme="@style/Theme.ManhwaStudio">

        <!-- The native library winit's SecondaryWindowActivity loads (a process may start from a
             restored secondary-window task, before MainActivity loaded it); = the cdylib name. -->
        <meta-data
            android:name="rs.winit.android.NATIVE_LIB"
            android:value="manhwastudio_rs" />

        <activity
            android:name=".LaunchActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|locale|layoutDirection|fontScale|touchscreen|colorMode"
            android:exported="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.ManhwaStudio.Launch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Edge-to-edge is enforced (targetSdk 35): the window is never resized for the system
             bars or the keyboard. adjustResize stays because it makes Android report the
             keyboard as an ime() window inset instead of panning the window; the winit fork
             folds that inset into the safe area egui lays out in (android/README.md, "Window
             insets"). Do NOT add windowOptOutEdgeToEdgeEnforcement. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|locale|layoutDirection|fontScale|touchscreen|colorMode"
            android:exported="false"
            android:resizeableActivity="true"
            android:theme="@style/Theme.ManhwaStudio"
            android:windowSoftInputMode="adjustResize">
            <!-- The library GameActivity loads; must equal the Rust cdylib name. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="manhwastudio_rs" />
        </activity>

        <!-- Invisible host of one Storage Access Framework picker (platform/SafBridge.kt, the
             Kotlin half of the Rust file-dialog seam). Translucent so the requesting window
             stays visible behind the picker; started without NEW_TASK over that window. -->
        <activity
            android:name=".platform.SafRequestActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|locale|layoutDirection|fontScale|touchscreen|colorMode"
            android:exported="false"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
