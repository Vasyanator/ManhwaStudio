{
  "manifest_version": 3,
  "name": "ManhwaStudio Bridge",
  "short_name": "ManhwaStudio",
  "version": "1.0.0",
  "description": "Connects your browser to the running ManhwaStudio app (machine translation through your own browser session).",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["scripting", "storage", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://translate.google.com/*",
    "https://www.deepl.com/*",
    "https://translate.yandex.ru/*",
    "https://translate.yandex.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
